{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    "react/react-in-jsx-scope": "off",
    "no-console": "error",
    "eqeqeq": "error",
    "typescript/no-explicit-any": "error",
    // Side-effect imports are load-bearing here: the library imports its own
    // stylesheet, and both test setups install environment shims.
    "import/no-unassigned-import": "off"
  },
  "overrides": [
    {
      // Build and CI scripts talk to the operator through stdout — that is
      // their interface, not a stray debug statement.
      "files": ["scripts/**"],
      "rules": {
        "no-console": "off"
      }
    }
  ],
  "ignorePatterns": ["**/dist/**", "**/node_modules/**", "**/coverage/**", ".claude/**"]
}
